rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /access_codes/{document=**} {
      allow read, write: if true;
    }
    match /system_config/{document=**} {
      allow read, write: if true;
    }
    match /admin_progress/{document=**} {
      allow read, write: if true;
    }
    match /test/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
